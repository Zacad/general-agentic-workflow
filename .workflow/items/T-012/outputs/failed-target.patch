diff --git a/cli/tests/Validate/StructureValidatorTest.php b/cli/tests/Validate/StructureValidatorTest.php
new file mode 100644
index 0000000..26aa989
--- /dev/null
+++ b/cli/tests/Validate/StructureValidatorTest.php
@@ -0,0 +1,136 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Workflow\Tests\Validate;
+
+use PHPUnit\Framework\Attributes\DataProvider;
+use PHPUnit\Framework\TestCase;
+use Workflow\Domain\Item;
+use Workflow\Domain\Kind;
+use Workflow\Validate\StructureValidator;
+
+final class StructureValidatorTest extends TestCase
+{
+    private function make(string $id, Kind $kind = Kind::Task, ?string $parent = null, array $depends = []): Item
+    {
+        return Item::fromArray([
+            'id' => $id, 'kind' => $kind->value, 'parent' => $parent, 'depends_on' => $depends,
+        ], '');
+    }
+
+    public static function invalidStructures(): iterable
+    {
+        yield 'identity' => ['T-002', Kind::Epic, null, [], 'id does not match kind epic'];
+        yield 'malformed id' => ['task-2', Kind::Task, null, [], 'id does not match kind task'];
+        yield 'epic parent' => ['E-002', Kind::Epic, 'E-001', [], 'an epic cannot have a parent'];
+        yield 'task parent task' => ['T-002', Kind::Task, 'T-001', [], 'task parent must be a epic'];
+        yield 'task parent subtask' => ['T-002', Kind::Task, 'S-001', [], 'task parent must be a epic'];
+        yield 'missing subtask parent' => ['S-002', Kind::Subtask, null, [], 'a subtask requires a task parent'];
+        yield 'subtask parent epic' => ['S-002', Kind::Subtask, 'E-001', [], 'subtask parent must be a task'];
+        yield 'subtask parent subtask' => ['S-002', Kind::Subtask, 'S-001', [], 'subtask parent must be a task'];
+        yield 'missing parent reference' => ['T-002', Kind::Task, 'E-999', [], 'parent E-999 does not exist'];
+        yield 'self parent' => ['T-002', Kind::Task, 'T-002', [], 'own parent'];
+        yield 'missing dependency' => ['T-002', Kind::Task, null, ['T-999'], 'dependency T-999 does not exist'];
+        yield 'self dependency' => ['T-002', Kind::Task, null, ['T-002'], 'depends on itself'];
+    }
+
+    #[DataProvider('invalidStructures')]
+    public function testFullAndCandidateShareStructuralDiagnostics(string $id, Kind $kind, ?string $parent, array $depends, string $message): void
+    {
+        $items = [
+            'E-001' => $this->make('E-001', Kind::Epic),
+            'T-001' => $this->make('T-001', Kind::Task, 'E-001'),
+            'S-001' => $this->make('S-001', Kind::Subtask, 'T-001'),
+        ];
+        $candidate = $this->make($id, $kind, $parent, $depends);
+        $validator = new StructureValidator();
+
+        self::assertStringContainsString($message, implode("\n", $validator->validateCandidate($candidate, $items)->errors));
+        $items[$id] = $candidate;
+        self::assertStringContainsString($message, implode("\n", $validator->validate($items)->errors));
+    }
+
+    public function testIdentityRejectsTrailingNewlineAndPathSegments(): void
+    {
+        foreach (["T-001\n", '../T-001', 'T-001/other', '', '123', 'T-', 'T-1x'] as $id) {
+            $candidate = $this->make('T-001');
+            $candidate->id = $id;
+            $validator = new StructureValidator();
+            self::assertFalse($validator->validateCandidate($candidate, [])->ok(), $id);
+            self::assertFalse($validator->validate([$candidate])->ok(), $id);
+        }
+    }
+
+    public function testValidHierarchyAndStandaloneGuidance(): void
+    {
+        $items = [
+            $this->make('E-001', Kind::Epic),
+            $this->make('T-001', Kind::Task, 'E-001'),
+            $this->make('S-001', Kind::Subtask, 'T-001', ['T-001']),
+            $this->make('T-002'),
+        ];
+        $result = (new StructureValidator())->validate($items);
+        self::assertSame([], $result->errors);
+        self::assertSame(['T-002: standalone task without standalone_reason.'], $result->warnings);
+        $items[3]->extra['standalone_reason'] = 'Independent maintenance';
+        self::assertSame([], (new StructureValidator())->validate($items)->warnings);
+    }
+
+    public function testCandidateFindsLongCycleDespiteOtherBackEdges(): void
+    {
+        $items = [
+            'T-002' => $this->make('T-002', depends: ['T-003']),
+            'T-003' => $this->make('T-003', depends: ['T-002', 'T-004']),
+            'T-004' => $this->make('T-004', depends: ['T-001']),
+        ];
+        $candidate = $this->make('T-001', depends: ['T-002']);
+        $result = (new StructureValidator())->validateCandidate($candidate, $items);
+        self::assertSame(['Dependency cycle: T-001 -> T-002 -> T-003 -> T-004 -> T-001'], $result->errors);
+    }
+
+    public function testLegacyDefectsIncludingReachableCyclesDoNotGateCandidate(): void
+    {
+        $items = [
+            'S-001' => $this->make('S-001', Kind::Subtask),
+            'T-002' => $this->make('T-002', depends: ['T-003', 'T-999']),
+            'T-003' => $this->make('T-003', depends: ['T-002']),
+        ];
+        $candidate = $this->make('T-001', depends: ['T-002']);
+        $before = serialize([$candidate, $items]);
+        $validator = new StructureValidator();
+
+        self::assertTrue($validator->validateCandidate($candidate, $items)->ok());
+        self::assertSame($before, serialize([$candidate, $items]), 'Pure checks must not repair or mutate records.');
+        $all = $validator->validate($items);
+        self::assertStringContainsString('requires a task parent', implode("\n", $all->errors));
+        self::assertStringContainsString('dependency T-999 does not exist', implode("\n", $all->errors));
+        self::assertStringContainsString('Dependency cycle', implode("\n", $all->errors));
+    }
+
+    public function testParentKindRepairChecksExistingChildren(): void
+    {
+        $items = [
+            'T-001' => $this->make('T-001', Kind::Epic),
+            'T-002' => $this->make('T-002', Kind::Task, 'T-001'),
+        ];
+        $result = (new StructureValidator())->validateCandidate($this->make('T-001'), $items);
+        self::assertSame(['T-002: task parent must be a epic, got task.'], $result->errors);
+    }
+
+    public function testCreatingMissingParentAlsoChecksReverseRelationships(): void
+    {
+        $child = $this->make('S-001', Kind::Subtask, 'E-001');
+        $result = (new StructureValidator())->validateCandidate($this->make('E-001', Kind::Epic), ['S-001' => $child]);
+        self::assertSame(['S-001: subtask parent must be a task, got epic.'], $result->errors);
+    }
+
+    public function testUnchangedParentKindDoesNotGateOnLegacyChildDefect(): void
+    {
+        $items = [
+            'E-001' => $this->make('E-001', Kind::Epic),
+            'S-001' => $this->make('S-001', Kind::Subtask, 'E-001'),
+        ];
+        self::assertTrue((new StructureValidator())->validateCandidate($this->make('E-001', Kind::Epic), $items)->ok());
+    }
+}
diff --git a/cli/tests/Store/StructureWriteTest.php b/cli/tests/Store/StructureWriteTest.php
new file mode 100644
index 0000000..3b888a8
--- /dev/null
+++ b/cli/tests/Store/StructureWriteTest.php
@@ -0,0 +1,308 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Workflow\Tests\Store;
+
+use PHPUnit\Framework\Attributes\DataProvider;
+use Workflow\Domain\FrontMatter;
+use Workflow\Domain\InvalidItemException;
+use Workflow\Domain\Item;
+use Workflow\Domain\Kind;
+use Workflow\Domain\WorkflowException;
+use Workflow\Store\ItemStore;
+use Workflow\Tests\WorkflowTestCase;
+use Workflow\Validate\ItemValidator;
+
+final class StructureWriteTest extends WorkflowTestCase
+{
+    private ItemStore $store;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->store = new ItemStore($this->root);
+        $this->store->create($this->make('E-001', Kind::Epic));
+        $this->store->create($this->make('T-001', parent: 'E-001'));
+        $this->store->create($this->make('S-001', Kind::Subtask, 'T-001'));
+    }
+
+    private function make(string $id, Kind $kind = Kind::Task, ?string $parent = null, array $depends = []): Item
+    {
+        return Item::fromArray([
+            'id' => $id, 'kind' => $kind->value, 'parent' => $parent, 'depends_on' => $depends,
+        ], "## Plan\n\n## Design\n");
+    }
+
+    /** Explicitly unsafe fixture setup, never a supported write route. */
+    private function writeRaw(Item $item): void
+    {
+        $directory = dirname($this->store->itemPath($item->id));
+        if (!is_dir($directory)) {
+            mkdir($directory, 0777, true);
+        }
+        file_put_contents($directory.'/item.md', FrontMatter::render($item->toArray(), $item->body));
+    }
+
+    private function bytes(): array
+    {
+        $bytes = [];
+        foreach ($this->store->ids() as $id) {
+            $bytes[$id] = file_get_contents($this->store->itemPath($id));
+        }
+
+        return $bytes;
+    }
+
+    public static function invalidWrites(): iterable
+    {
+        $cases = [
+            'kind identity' => [['kind' => Kind::Subtask], 'id does not match kind'],
+            'id identity' => [['id' => 'E-005'], 'id'],
+            'malformed id' => [['id' => '../T-005'], 'id'],
+            'epic parent' => [['kind' => Kind::Epic], 'an epic cannot have a parent'],
+            'task parent task' => [['parent' => 'T-001'], 'task parent must be a epic'],
+            'task parent subtask' => [['parent' => 'S-001'], 'task parent must be a epic'],
+            'missing parent' => [['parent' => 'E-999'], 'parent E-999 does not exist'],
+            'self parent' => [['parent' => 'T-002'], 'own parent'],
+            'self dependency' => [['dependsOn' => ['T-002']], 'depends on itself'],
+            'missing dependency' => [['dependsOn' => ['T-999']], 'dependency T-999 does not exist'],
+            'long cycle' => [['dependsOn' => ['T-003']], 'Dependency cycle'],
+        ];
+        foreach (['create', 'save', 'mutate'] as $route) {
+            foreach ($cases as $name => [$changes, $message]) {
+                yield $route.' '.$name => [$route, $changes, $message];
+            }
+        }
+    }
+
+    #[DataProvider('invalidWrites')]
+    public function testInvalidWritesAreAtomic(string $route, array $changes, string $message): void
+    {
+        $candidate = $this->make('T-002', parent: 'E-001');
+        if ($route !== 'create') {
+            $this->store->create($candidate);
+        }
+        $this->writeRaw($this->make('T-003', depends: ['T-004']));
+        $this->writeRaw($this->make('T-004', depends: ['T-002']));
+        $before = $this->bytes();
+
+        $change = static function (Item $item) use ($changes): void {
+            $item->title = 'Must not persist';
+            foreach ($changes as $field => $value) {
+                $item->{$field} = $value;
+            }
+        };
+        try {
+            if ($route === 'mutate') {
+                $this->store->mutate('T-002', $change);
+            } else {
+                $change($candidate);
+                $this->store->{$route}($candidate);
+            }
+            self::fail('Invalid '.$route.' succeeded.');
+        } catch (InvalidItemException $exception) {
+            self::assertStringContainsString($message, $exception->getMessage());
+        }
+
+        self::assertSame($before, $this->bytes());
+        self::assertSame(array_keys($before), $this->store->ids(), 'No new item directory may remain.');
+    }
+
+    public static function subtaskWrites(): iterable
+    {
+        foreach (['create', 'save', 'mutate'] as $route) {
+            foreach ([null, 'E-001', 'S-001', 'T-999', 'S-002'] as $parent) {
+                yield $route.' '.($parent ?? 'none') => [$route, $parent];
+            }
+        }
+    }
+
+    #[DataProvider('subtaskWrites')]
+    public function testSubtaskParentRulesApplyToEveryRoute(string $route, ?string $parent): void
+    {
+        $candidate = $this->make('S-002', Kind::Subtask, 'T-001');
+        if ($route !== 'create') {
+            $this->store->create($candidate);
+        }
+        $before = $this->bytes();
+        try {
+            if ($route === 'mutate') {
+                $this->store->mutate('S-002', static function (Item $item) use ($parent): void {
+                    $item->parent = $parent;
+                });
+            } else {
+                $candidate->parent = $parent;
+                $this->store->{$route}($candidate);
+            }
+            self::fail('Invalid subtask parent persisted.');
+        } catch (InvalidItemException) {
+            self::assertSame($before, $this->bytes());
+            self::assertSame(array_keys($before), $this->store->ids());
+        }
+    }
+
+    public function testMutateCannotRenameAnItemEvenToAnotherValidId(): void
+    {
+        $before = $this->bytes();
+        try {
+            $this->store->mutate('T-001', static function (Item $item): void {
+                $item->id = 'T-999';
+            });
+            self::fail('Mutation renamed the item.');
+        } catch (InvalidItemException $exception) {
+            self::assertStringContainsString('Cannot change item id', $exception->getMessage());
+        }
+        self::assertSame($before, $this->bytes());
+        self::assertDirectoryDoesNotExist($this->store->itemsDir().'/T-999');
+    }
+
+    public function testSaveCanCreateButCannotBypassStructureChecks(): void
+    {
+        $candidate = $this->make('S-002', Kind::Subtask);
+        try {
+            $this->store->save($candidate);
+            self::fail('Invalid save created an item.');
+        } catch (InvalidItemException) {
+            self::assertDirectoryDoesNotExist($this->store->itemsDir().'/S-002');
+        }
+        $candidate->parent = 'T-001';
+        $this->store->save($candidate);
+        self::assertSame('T-001', $this->store->load('S-002')->parent);
+    }
+
+    public function testKindRepairCannotInvalidateExistingChildren(): void
+    {
+        $this->writeRaw($this->make('T-002', Kind::Epic));
+        $this->writeRaw($this->make('T-003', parent: 'T-002'));
+        $before = $this->bytes();
+        foreach (['save', 'mutate'] as $route) {
+            try {
+                if ($route === 'save') {
+                    $this->store->save($this->make('T-002'));
+                } else {
+                    $this->store->mutate('T-002', static function (Item $item): void {
+                        $item->kind = Kind::Task;
+                    });
+                }
+                self::fail('Kind repair invalidated a child.');
+            } catch (InvalidItemException $exception) {
+                self::assertStringContainsString('T-003: task parent must be a epic, got task.', $exception->getMessage());
+            }
+            self::assertSame($before, $this->bytes());
+        }
+    }
+
+    public function testCreationCannotResolveLegacyParentToWrongKind(): void
+    {
+        $this->writeRaw($this->make('S-002', Kind::Subtask, 'E-002'));
+        $before = $this->bytes();
+        try {
+            $this->store->create($this->make('E-002', Kind::Epic));
+            self::fail('Creation left an affected child with a wrong-kind parent.');
+        } catch (InvalidItemException) {
+            self::assertSame($before, $this->bytes());
+            self::assertDirectoryDoesNotExist($this->store->itemsDir().'/E-002');
+        }
+    }
+
+    public function testKindRepairCanAlsoRepairAnAffectedChild(): void
+    {
+        foreach (['save', 'mutate'] as $route) {
+            $this->writeRaw($this->make('T-002', Kind::Epic));
+            $this->writeRaw($this->make('S-002', Kind::Subtask, 'T-002'));
+            $childBytes = file_get_contents($this->store->itemPath('S-002'));
+            if ($route === 'save') {
+                $this->store->save($this->make('T-002'));
+            } else {
+                $this->store->mutate('T-002', static function (Item $item): void {
+                    $item->kind = Kind::Task;
+                });
+            }
+
+            self::assertSame(Kind::Task, $this->store->load('T-002')->kind);
+            self::assertSame($childBytes, file_get_contents($this->store->itemPath('S-002')));
+            self::assertSame([], (new ItemValidator($this->store))->validate()->errors);
+        }
+    }
+
+    public function testUnrelatedLegacyDefectsDoNotBlockValidWritesOrRepairs(): void
+    {
+        $this->writeRaw($this->make('S-002', Kind::Subtask));
+        $this->writeRaw($this->make('T-002', depends: ['T-003', 'T-999']));
+        $this->writeRaw($this->make('T-003', depends: ['T-002']));
+        mkdir($this->store->itemsDir().'/T-004');
+        file_put_contents($this->store->itemPath('T-004'), "---\nkind: [invalid\n---\n");
+        $legacy = $this->bytes();
+
+        $this->store->create($this->make('T-005', depends: ['T-002']));
+        $valid = $this->store->load('T-005');
+        $valid->title = 'Updated';
+        $this->store->save($valid);
+        self::assertSame('Updated', $this->store->load('T-005')->title);
+        $this->store->mutate('S-002', static function (Item $item): void {
+            $item->parent = 'T-001';
+        });
+        $this->store->mutate('T-002', static function (Item $item): void {
+            $item->dependsOn = [];
+        });
+
+        self::assertSame('T-001', $this->store->load('S-002')->parent);
+        self::assertSame([], $this->store->load('T-002')->dependsOn);
+        foreach (['T-003', 'T-004'] as $id) {
+            self::assertSame($legacy[$id], file_get_contents($this->store->itemPath($id)));
+        }
+        self::assertNotEmpty((new ItemValidator($this->store))->validate()->errors, 'Full validate must still report malformed legacy data.');
+    }
+
+    public function testNoWorkflowGatesAreAdded(): void
+    {
+        $candidate = $this->make('T-002', depends: ['T-001']);
+        $candidate->status = \Workflow\Domain\Status::InProgress;
+        $candidate->phase = \Workflow\Domain\Phase::Verify;
+        $candidate->owns = ['shared/path'];
+        $candidate->artifacts = ['missing.md'];
+        $this->store->create($candidate);
+        $this->store->save($candidate);
+        $this->store->mutate('T-002', static function (Item $item): void {
+            $item->priority = 1;
+        });
+
+        $loaded = $this->store->load('T-002');
+        self::assertNull($loaded->approval);
+        self::assertSame(1, $loaded->priority);
+        self::assertSame('', $loaded->section('Plan'));
+        self::assertSame('', $loaded->section('Design'));
+        $diagnostics = (new ItemValidator($this->store))->validate();
+        self::assertStringContainsString('in-progress without approval', implode("\n", $diagnostics->errors));
+        self::assertStringContainsString('standalone task without standalone_reason', implode("\n", $diagnostics->warnings));
+        self::assertStringContainsString('without a plan', implode("\n", $diagnostics->warnings));
+        self::assertStringContainsString('without a design', implode("\n", $diagnostics->warnings));
+    }
+
+    public function testGraphIsReadAfterMutationInsideWriteLock(): void
+    {
+        $before = file_get_contents($this->store->itemPath('T-001'));
+        try {
+            $this->store->mutate('T-001', function (Item $item): void {
+                // Simulate an affected edge appearing before final validation.
+                $this->writeRaw($this->make('T-002', depends: ['T-001']));
+                $item->dependsOn = ['T-002'];
+            });
+            self::fail('Persist did not check the current graph.');
+        } catch (InvalidItemException $exception) {
+            self::assertStringContainsString('Dependency cycle', $exception->getMessage());
+        }
+        self::assertSame($before, file_get_contents($this->store->itemPath('T-001')));
+
+        $this->store->withLock(function (): void {
+            try {
+                $this->store->save($this->make('T-003'));
+                self::fail('Save bypassed the existing lock.');
+            } catch (WorkflowException $exception) {
+                self::assertStringContainsString('Another workflow write', $exception->getMessage());
+            }
+        });
+        self::assertDirectoryDoesNotExist($this->store->itemsDir().'/T-003');
+    }
+}
diff --git a/cli/tests/Console/StructureCommandTest.php b/cli/tests/Console/StructureCommandTest.php
new file mode 100644
index 0000000..ab3b88a
--- /dev/null
+++ b/cli/tests/Console/StructureCommandTest.php
@@ -0,0 +1,134 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Workflow\Tests\Console;
+
+use PHPUnit\Framework\Attributes\DataProvider;
+use Symfony\Component\Console\Input\ArrayInput;
+use Symfony\Component\Console\Output\BufferedOutput;
+use Workflow\Console\Application;
+use Workflow\Domain\FrontMatter;
+use Workflow\Store\ItemStore;
+use Workflow\Tests\WorkflowTestCase;
+
+final class StructureCommandTest extends WorkflowTestCase
+{
+    private ItemStore $store;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        self::assertSame(0, $this->runCli(['command' => 'init', '--name' => 'structure'])[0]);
+        self::assertSame(0, $this->runCli(['command' => 'new', 'title' => 'Epic', '--kind' => 'epic'])[0]);
+        self::assertSame(0, $this->runCli(['command' => 'new', 'title' => 'Task', '--parent' => 'E-001'])[0]);
+        self::assertSame(0, $this->runCli(['command' => 'new', 'title' => 'Subtask', '--kind' => 'subtask', '--parent' => 'T-001'])[0]);
+        $this->store = new ItemStore($this->root);
+    }
+
+    /** @return array{int, string} */
+    private function runCli(array $input): array
+    {
+        $application = new Application();
+        $application->setAutoExit(false);
+        $output = new BufferedOutput();
+        $exit = $application->run(new ArrayInput(['--project' => $this->root] + $input), $output);
+
+        return [$exit, $output->fetch()];
+    }
+
+    private function bytes(): array
+    {
+        $bytes = ['board' => file_get_contents($this->root.'/.workflow/board.html')];
+        foreach ($this->store->ids() as $id) {
+            $bytes[$id] = file_get_contents($this->store->itemPath($id));
+        }
+
+        return $bytes;
+    }
+
+    public static function invalidNew(): iterable
+    {
+        yield 'epic parent' => [['--kind' => 'epic', '--parent' => 'E-001'], 'an epic cannot have a parent'];
+        yield 'task parent task' => [['--parent' => 'T-001'], 'task parent must be a epic'];
+        yield 'task parent subtask' => [['--parent' => 'S-001'], 'task parent must be a epic'];
+        yield 'subtask no parent' => [['--kind' => 'subtask'], 'a subtask requires a task parent'];
+        yield 'subtask explicit none' => [['--kind' => 'subtask', '--parent' => 'none'], 'a subtask requires a task parent'];
+        yield 'subtask parent epic' => [['--kind' => 'subtask', '--parent' => 'E-001'], 'subtask parent must be a task'];
+        yield 'subtask parent subtask' => [['--kind' => 'subtask', '--parent' => 'S-001'], 'subtask parent must be a task'];
+        yield 'missing parent' => [['--parent' => 'E-999'], 'parent E-999 does not exist'];
+        yield 'self parent' => [['--parent' => 'T-002'], 'own parent'];
+        yield 'missing dependency' => [['--depends' => ['T-999']], 'dependency T-999 does not exist'];
+        yield 'self dependency' => [['--depends' => ['T-002']], 'depends on itself'];
+    }
+
+    #[DataProvider('invalidNew')]
+    public function testNewRefusesStructureWithoutLeavingAnItem(array $options, string $message): void
+    {
+        $before = $this->bytes();
+        [$exit, $output] = $this->runCli(['command' => 'new', 'title' => 'Invalid'] + $options);
+
+        self::assertSame(2, $exit, $output);
+        self::assertStringContainsString($message, $output);
+        self::assertSame($before, $this->bytes());
+        self::assertSame(['E-001', 'S-001', 'T-001'], $this->store->ids());
+    }
+
+    public static function invalidSet(): iterable
+    {
+        yield 'task parent task' => ['T-001', ['parent=T-002'], 'task parent must be a epic'];
+        yield 'epic parent' => ['E-001', ['parent=T-001'], 'an epic cannot have a parent'];
+        yield 'subtask no parent' => ['S-001', ['parent=none'], 'a subtask requires a task parent'];
+        yield 'subtask parent epic' => ['S-001', ['parent=E-001'], 'subtask parent must be a task'];
+        yield 'missing parent' => ['T-001', ['parent=E-999'], 'parent E-999 does not exist'];
+        yield 'self parent' => ['T-001', ['parent=T-001'], 'own parent'];
+        yield 'missing dependency' => ['T-001', ['depends_on=T-999'], 'dependency T-999 does not exist'];
+        yield 'self dependency' => ['T-001', ['depends_on=T-001'], 'depends on itself'];
+        yield 'long cycle' => ['T-001', ['depends_on=T-003'], 'Dependency cycle'];
+    }
+
+    #[DataProvider('invalidSet')]
+    public function testSetRejectsWholeMultiAssignmentAtomically(string $id, array $assignments, string $message): void
+    {
+        self::assertSame(0, $this->runCli(['command' => 'new', 'title' => 'Second', '--depends' => ['T-001']])[0]);
+        self::assertSame(0, $this->runCli(['command' => 'new', 'title' => 'Third', '--depends' => ['T-002']])[0]);
+        $before = $this->bytes();
+        [$exit, $output] = $this->runCli([
+            'command' => 'set', 'id' => $id,
+            'assignments' => ['title=Must not persist', ...$assignments, 'priority=7'],
+        ]);
+
+        self::assertSame(2, $exit, $output);
+        self::assertStringContainsString($message, $output);
+        self::assertSame($before, $this->bytes());
+    }
+
+    public function testNewDetectsCycleThroughLegacyIncomingReference(): void
+    {
+        // A historical missing reference can become a cycle when its target is created.
+        $legacy = $this->store->load('T-001');
+        $legacy->dependsOn = ['T-002'];
+        file_put_contents($this->store->itemPath('T-001'), FrontMatter::render($legacy->toArray(), $legacy->body));
+        $before = $this->bytes();
+        [$exit, $output] = $this->runCli(['command' => 'new', 'title' => 'Invalid cycle', '--depends' => ['T-001']]);
+
+        self::assertSame(2, $exit, $output);
+        self::assertStringContainsString('Dependency cycle', $output);
+        self::assertSame($before, $this->bytes());
+        self::assertDirectoryDoesNotExist($this->store->itemsDir().'/T-002');
+    }
+
+    public function testStandaloneTaskIsAllowedAndGuidanceRemainsWarningOnly(): void
+    {
+        [$exit, $output] = $this->runCli(['command' => 'new', 'title' => 'Standalone', '--phase' => 'verify']);
+        self::assertSame(0, $exit, $output);
+        [$exit, $output] = $this->runCli(['command' => 'set', 'id' => 'T-002', 'assignments' => ['status=in-progress']]);
+        self::assertSame(0, $exit, $output);
+        [$exit, $output] = $this->runCli(['command' => 'validate']);
+        self::assertSame(1, $exit, $output);
+        self::assertStringContainsString('standalone task without standalone_reason', $output);
+        self::assertStringContainsString('in-progress without approval', $output);
+        self::assertStringContainsString('verify without a plan', $output);
+        self::assertStringContainsString('verify without a design', $output);
+    }
+}
